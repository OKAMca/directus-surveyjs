{
	"name": "directus-extension-surveyjs",
	"description": "Bundles a module and api endpoints Directus extenstions with SurveyJS to make the form creation and submission process easier",
	"icon": "extension",
	"version": "1.1.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "creator",
				"source": "src/creator/index.ts"
			},
			{
				"type": "endpoint",
				"name": "survey-api",
				"source": "src/survey-api/index.ts"
			}
		],
		"host": "^11.8.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"dependencies": {
		"@vueuse/core": "11.0.1",
		"lodash": "4.18.1",
		"survey-core": "2.5.29",
		"survey-creator-core": "2.5.29",
		"survey-creator-vue": "2.5.29",
		"survey-vue3-ui": "2.5.29",
		"vue": "3.5.45",
		"vue-router": "4.6.3"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.1.4",
		"@types/lodash": "4.17.7",
		"@types/node": "22.3.0",
		"typescript": "5.5.4",
		"vitest": "4.1.12",
		"vue": "3.5.45",
		"vue-i18n": "11.4.14"
	},
	"overrides": {
		"@unhead/vue": "2.1.17",
		"axios": "1.21.0",
		"deepmerge": "npm:@shivammathur/deepmerge@4.3.2",
		"follow-redirects": "1.16.2",
		"form-data": "4.0.6",
		"joi": "18.3.1",
		"js-yaml": "4.3.2",
		"lodash-es": "4.18.1",
		"nanoid@5": "5.1.16",
		"serialize-javascript": "7.1.4",
		"vite": "8.3.5",
		"vue": "$vue",
		"zod": "4.6.7"
	}
}
