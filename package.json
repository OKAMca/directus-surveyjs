{
	"name": "directus-extension-surveyjs",
	"description": "Bundles a module and api endpoints Directus extenstions with SurveyJS to make the form creation and submission process easier",
	"icon": "extension",
	"version": "1.1.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "creator",
				"source": "src/creator/index.ts"
			},
			{
				"type": "endpoint",
				"name": "survey-api",
				"source": "src/survey-api/index.ts"
			}
		],
		"host": "11.13.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"dependencies": {
		"@vueuse/core": "11.0.1",
		"lodash": "4.18.1",
		"survey-core": "2.5.29",
		"survey-creator-core": "2.5.29",
		"survey-creator-vue": "2.5.29",
		"survey-vue3-ui": "2.5.29",
		"vue": "3.4.37",
		"vue-router": "4.4.3"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "11.0.9",
		"@types/lodash": "4.17.7",
		"@types/node": "22.3.0",
		"typescript": "5.5.4",
		"vitest": "3.2.7",
		"vue": "3.4.37",
		"vue-i18n": "9.4.0"
	},
	"overrides": {
		"axios": "1.18.1",
		"form-data": "4.0.6",
		"lodash-es": "4.18.1",
		"serialize-javascript": "7.0.7"
	}
}
